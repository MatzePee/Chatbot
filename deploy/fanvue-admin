#!/usr/bin/env bash
# Fixed, root-owned system actions. All code and package operations run as SVC_USER.
set -euo pipefail
REPO="/srv/fanvue/Fanvue_Chatbot"
SVC_USER="matze"
SERVICE="fanvue-chatbot"
case "${1:-}" in
  update)
    exec systemd-run --no-block --collect --unit="fanvue-update" \
      /usr/bin/python3 /usr/local/libexec/mp-creatorstudio-update run "$REPO" "$SVC_USER" "$SERVICE"
    ;;
  restart-service)
    exec systemd-run --no-block --collect --unit="fanvue-restart-$$" systemctl restart "$SERVICE"
    ;;
  reboot)
    exec systemd-run --no-block --collect --unit="fanvue-reboot-$$" systemctl reboot
    ;;
  *) echo 'usage: fanvue-admin {restart-service|reboot|update}' >&2; exit 1 ;;
esac
