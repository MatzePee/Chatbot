# Kopiere diese Datei zu .env und trage deine Werte ein.
# Alle Werte lassen sich auch in der GUI unter "Einstellungen" pflegen;
# die .env dient nur als bequemer Startwert.

# --- Server ---
# Auf dem Server 0.0.0.0, damit die GUI vom Mac aus erreichbar ist.
HOST=0.0.0.0
PORT=8000
# Zufaelliger Schluessel fuer Session-Cookies. Mit  openssl rand -hex 32  erzeugen.
SECRET_KEY=bitte-hier-eine-lange-zufaellige-zeichenkette-eintragen

# --- Fanvue OAuth (aus deiner Fanvue Creator App) ---
FANVUE_CLIENT_ID=
FANVUE_CLIENT_SECRET=
# Muss exakt so in deiner Fanvue-App als Redirect-URI hinterlegt sein
# (Server-IP verwenden, damit der Browser vom Mac aus zurueckfindet):
FANVUE_REDIRECT_URI=http://192.168.20.16:8000/oauth/callback

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
